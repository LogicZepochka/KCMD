end if
end function
Commands.Cmds[""crack""]={""info"":""Расшифровать пароль"",""args"":""[шифр]"",""types"":[""shell"",""computer"",""file""]}
Commands.Cmds[""crack""][""exe""]=function(args)
if args.len<1 then
UI.printError(""Использование: <b>crack [шифр]</b>"")
return 0
end if
UI.print(""Взламываем..."")
wait(1)
result=crypto.decipher(args[0])
wait(1)
