end if
id=args[0].to_int
if typeof(id)==""string"" then return UI.printError(""Использование: <b>deltarget [ID / all]</b>"")
if id>=globals.targets.len or id<0 then return UI.printError(""Не найдена цель под данным ID"")
globals.targets.remove(id)
