Test""",1);m("/home/logzep/ZQnVB/Dictionary/DictionaryManager.src","Dictionary={}
Dictionary.passwords=[]
Dictionary.init=function
self.passwords=[]
self.passwords=self.passwords+list1.split(""\n"")
self.passwords=self.passwords+list2.split(""\n"")
self.passwords=self.passwords+list3.split(""\n"")
self.passwords=self.passwords+list4.split(""\n"")
self.passwords=self.passwords+list5.split(""\n"")
self.passwords=self.passwords+list6.split(""\n"")
self.passwords.shuffle
self.len=self.passwords.len
self.index=0
end function
Dictionary.requestNextPassword=function
result=self.passwords[self.index]
self.index=self.index+1
if self.index==self.len then
self.index=0
end if
return result
end function
Dictionary.New=function
result=new Dictionary
result.init
print(""Dictionary initialized with ""+result.len+"" passwords"")
return result
end function",1);m("/home/logzep/ZQnVB/UI/UI.src","UI={}
UI.print=function(text,prefix=""KCMD2"")
print(""[<color=#558C8C>""+prefix+""</color>] <color=#9EE493>""+text)
end function
UI.printWarning=function(text,prefix=""WRN"")
print(""[<color=#D17A22>""+prefix+""</color>] <color=#9EE493>""+text)
end function
UI.printError=function(text,prefix=""ERR"")
print(""[<color=#A44A3F>""+prefix+""</color>] <color=#A44A3F>""+text)
end function
UI.user_input=function(text,prefix=""CMD"",isPass=0)
return user_input(""[<color=#FFA630>""+prefix+""</color>] ""+text,isPass)
end function
UI.ask_user=function(question,yes=""Y"",no=""N"")
answer=""""
while answer.lower!=yes.lower and answer.lower!=no.lower
answer=self.user_input(question+""[""+yes+"" / ""+no+""]"")
end while
return answer.lower==yes.lower
end function",1);m("/home/logzep/ZQnVB/libs.src","meta=include_lib(""/lib/metaxploit.so"")
if not meta then
meta=include_lib(current_path+""/metaxploit.so"")
if not meta then UI.printError(""<color=red>metaxploit.so не обнаружен</color>"")
end if
crypto=include_lib(""/lib/crypto.so"")
if not crypto then
crypto=include_lib(current_path+""/crypto.so"")
if not crypto then UI.printError(""<color=red>crypto.so не обнаружен</color>"")
end if
randIp=function
ip=""""
while not is_valid_ip(ip)
ip=floor(rnd*(255-1+1)+1)+"".""+floor(rnd*(255-1+1)+1)+"".""+floor(rnd*(255-1+1)+1)+"".""+floor(rnd*(255-1+1)+1)
end while
return ip
end function
printPercent=function(value,maxValue)
str=""[""
percent=floor(value/maxValue*100)
for i in range(0,10)
if i>=floor(percent/100) then str=str+""#"" else str=str+""_""
end for
str=str+""] (""+percent+""%)""
return str
end function
getComputerProtectionData=function(folder,data)
data[""Total""]=data[""Total""]+1
if (folder.has_permission(""r"")) then data[""Read""]=data[""Read""]+1
if (folder.has_permission(""w"")) then data[""Write""]=data[""Write""]+1
if (folder.has_permission(""x"")) then data[""Exe""]=data[""Exe""]+1
for file in folder.get_files
data[""Total""]=data[""Total""]+1
if (file.has_permission(""r"")) then data[""Read""]=data[""Read""]+1
if (file.has_permission(""w"")) then data[""Write""]=data[""Write""]+1
if (file.has_permission(""x"")) then data[""Exe""]=data[""Exe""]+1
end for
for fld in folder.get_folders
getComputerProtectionData(fld,@data)
end for
end function
getUserFromTarget=function(target)
rootFile=target.comp.File(""/root"")
if rootFile!=null then
if (rootFile.has_permission(""w"")) then
UI.print(""<color=red><b>ROOT получен</b></color>"")
return ""root""
end if
end if
homeFile=target.comp.File(""/home"")
if homeFile!=null then
for user in homeFile.get_folders
if user.name==""guest"" then continue
if user.has_permission(""w"") then
return user.name
end if
end for
end if
guestFile=target.comp.File(""/home/guest"")
if guestFile!=null then
if (guestFile.has_permission(""w"")) then return ""guest""
end if
return ""unknown""
end function
searchReadAndExecuteFolder=function(target,startFolder=null)
if startFolder==null then startFolder=target.comp.File(""/"")
result=null
for folder in startFolder.get_folders
print("">>>>>>>> ""+folder.path+"" | EXECUTE: ""+folder.has_permission(""x"")+"" | WRITE: ""+folder.has_permission(""w""))
if folder.has_permission(""w"") and folder.has_permission(""x"") then
result=folder
break
else
result=searchReadAndExecuteFolder(target,folder)
if (result!=null) then
return result
end if
end if
end for
return result
end function",1);m("/home/logzep/ZQnVB/etc/metaHack.src","populateExplots=function(meta,metaLib)
exploitData=ExploitDB.Request(metaLib.lib_name,version(metaLib))
exploits={}
if exploitData==null then
scanResult=scan(meta,metaLib)
for mem in scanResult
exploits[mem]=[]
scanAddress=scan_address(meta,metaLib,mem)
segments=split(scanAddress,""Unsafe check: "")[1:]
for segment in segments
labelStart=indexOf(segment,""<b>"")
labelEnd=indexOf(segment,""</b>"")
exploits[mem].push(segment[labelStart+3:labelEnd])
end for
end for
end if
if exploits.indexes.len>0 then ExploitDB.SaveInDB(metaLib.lib_name,version(metaLib),exploits)
end function
scanExploits=function(meta,metaLib,ip=""local"",insertData="""")
exploitData=ExploitDB.Request(metaLib.lib_name,version(metaLib))
exploits={}
if exploitData==null then
scanResult=scan(meta,metaLib)
for mem in scanResult
exploits[mem]=[]
scanAddress=scan_address(meta,metaLib,mem)
segments=split(scanAddress,""Unsafe check: "")[1:]
for segment in segments
labelStart=indexOf(segment,""<b>"")
labelEnd=indexOf(segment,""</b>"")
exploits[mem].push(segment[labelStart+3:labelEnd])
end for
end for
ExploitDB.SaveInDB(metaLib.lib_name,version(metaLib),exploits)
else
exploits=exploitData
end if
for mem in exploits.indexes
for word in exploits[mem]
result=metaLib.overflow(mem,word,insertData)
if result!=null then
user=""---""
if typeof(result)==""number"" then continue
target=new Target
target.New(result,ip,user)
globals.targets.push(target)
end if
end for
end for
end function",1);m("/home/logzep/ZQnVB/Program.src","Program={}
Program.version=""1.4.0""
Program.configPath=""/Config/config.cfg""
